{
  "emi": {
    "slug": "emi-calculator",
    "name": "EMI Calculator",
    "nav": "EMI",
    "tagline": "Monthly instalment, total interest and a full repayment schedule for any loan.",
    "headline": {
      "label": "Monthly EMI",
      "out": "headline"
    },
    "fields": [
      {
        "name": "principal",
        "label": "Loan amount",
        "type": "money",
        "min": 100000,
        "max": 20000000,
        "step": 50000,
        "hardMin": 1000,
        "hardMax": 1000000000,
        "value": 5000000
      },
      {
        "name": "rate",
        "label": "Interest rate",
        "type": "percent",
        "unit": "% a year",
        "min": 5,
        "max": 20,
        "step": 0.05,
        "hardMin": 0,
        "hardMax": 40,
        "value": 8.5
      },
      {
        "name": "years",
        "label": "Loan tenure",
        "type": "years",
        "unit": "years",
        "min": 1,
        "max": 30,
        "step": 0.5,
        "hardMin": 0.25,
        "hardMax": 40,
        "value": 20,
        "toggle": true
      }
    ],
    "advanced": {
      "summary": "Add a monthly prepayment",
      "fields": [
        {
          "name": "extra",
          "label": "Extra payment every month",
          "type": "money",
          "min": 0,
          "max": 100000,
          "step": 1000,
          "hardMin": 0,
          "hardMax": 10000000,
          "value": 0
        }
      ]
    },
    "ledger": [
      {
        "out": "principal",
        "label": "Loan amount"
      },
      {
        "out": "interest",
        "label": "Total interest"
      },
      {
        "out": "total",
        "label": "Total you pay"
      },
      {
        "out": "ends",
        "label": "Loan is cleared in"
      },
      {
        "out": "saved",
        "label": "Interest saved by prepaying",
        "showIf": "extra"
      },
      {
        "out": "earlier",
        "label": "Cleared earlier by",
        "showIf": "extra"
      }
    ],
    "chart": {
      "title": "Principal and interest paid each year",
      "a": "Principal",
      "b": "Interest"
    },
    "donut": {
      "a": "Principal",
      "b": "Interest",
      "centre": "of what you pay is interest"
    },
    "table": {
      "title": "Repayment schedule",
      "toggle": true
    },
    "presets": [
      {
        "label": "Home loan",
        "values": {
          "principal": 5000000,
          "rate": 8.5,
          "years": 20
        }
      },
      {
        "label": "Car loan",
        "values": {
          "principal": 800000,
          "rate": 9.5,
          "years": 5
        }
      },
      {
        "label": "Personal loan",
        "values": {
          "principal": 300000,
          "rate": 12,
          "years": 3
        }
      },
      {
        "label": "Education loan",
        "values": {
          "principal": 1500000,
          "rate": 9,
          "years": 10
        }
      }
    ],
    "whatif": {
      "better": {
        "headline": "lower",
        "second": "lower"
      },
      "secondKey": "interest",
      "secondLabel": "Total interest",
      "items": [
        {
          "field": "rate",
          "delta": -1,
          "text": "Rate"
        },
        {
          "field": "rate",
          "delta": 1,
          "text": "Rate"
        },
        {
          "field": "years",
          "delta": -5,
          "text": "Tenure"
        },
        {
          "field": "years",
          "delta": 5,
          "text": "Tenure"
        }
      ]
    }
  },
  "sip": {
    "slug": "sip-calculator",
    "name": "SIP Calculator",
    "nav": "SIP",
    "tagline": "See what a monthly mutual fund SIP can grow into, with optional step-up and inflation.",
    "headline": {
      "label": "Estimated value",
      "out": "headline"
    },
    "fields": [
      {
        "name": "monthly",
        "label": "Monthly investment",
        "type": "money",
        "min": 500,
        "max": 100000,
        "step": 500,
        "hardMin": 100,
        "hardMax": 10000000,
        "value": 10000
      },
      {
        "name": "rate",
        "label": "Expected return",
        "type": "percent",
        "unit": "% a year",
        "min": 1,
        "max": 30,
        "step": 0.1,
        "hardMin": 0,
        "hardMax": 50,
        "value": 12
      },
      {
        "name": "years",
        "label": "Investment period",
        "type": "years",
        "unit": "years",
        "min": 1,
        "max": 40,
        "step": 1,
        "hardMin": 0.5,
        "hardMax": 60,
        "value": 15
      }
    ],
    "advanced": {
      "summary": "Add a lump sum, yearly step-up or inflation",
      "fields": [
        {
          "name": "lumpsum",
          "label": "Starting lump sum",
          "type": "money",
          "min": 0,
          "max": 10000000,
          "step": 10000,
          "hardMin": 0,
          "hardMax": 1000000000,
          "value": 0
        },
        {
          "name": "stepUp",
          "label": "Raise the SIP every year by",
          "type": "percent",
          "unit": "%",
          "min": 0,
          "max": 25,
          "step": 1,
          "hardMin": 0,
          "hardMax": 100,
          "value": 0
        },
        {
          "name": "inflation",
          "label": "Expected inflation",
          "type": "percent",
          "unit": "% a year",
          "min": 0,
          "max": 12,
          "step": 0.5,
          "hardMin": 0,
          "hardMax": 30,
          "value": 0
        }
      ]
    },
    "ledger": [
      {
        "out": "invested",
        "label": "You invest"
      },
      {
        "out": "gains",
        "label": "Estimated returns"
      },
      {
        "out": "value",
        "label": "Value at the end"
      },
      {
        "out": "real",
        "label": "Worth in today's money",
        "showIf": "inflation"
      }
    ],
    "chart": {
      "title": "Money invested and returns, year by year",
      "a": "Invested",
      "b": "Returns"
    },
    "donut": {
      "a": "Invested",
      "b": "Returns",
      "centre": "of the final value is returns"
    },
    "table": {
      "title": "Year-by-year growth",
      "toggle": false
    },
    "presets": [
      {
        "label": "{5000} for 10 years",
        "values": {
          "monthly": 5000,
          "rate": 12,
          "years": 10
        }
      },
      {
        "label": "{10000} for 15 years",
        "values": {
          "monthly": 10000,
          "rate": 12,
          "years": 15
        }
      },
      {
        "label": "{25000} with 10% step-up",
        "values": {
          "monthly": 25000,
          "rate": 12,
          "years": 20,
          "stepUp": 10
        }
      }
    ],
    "whatif": {
      "better": {
        "headline": "higher",
        "second": "higher"
      },
      "secondKey": "gains",
      "secondLabel": "Returns",
      "items": [
        {
          "field": "rate",
          "delta": -2,
          "text": "Return"
        },
        {
          "field": "rate",
          "delta": 2,
          "text": "Return"
        },
        {
          "field": "years",
          "delta": 5,
          "text": "Period"
        },
        {
          "field": "monthly",
          "mult": 1.25,
          "text": "SIP"
        }
      ]
    }
  },
